# Visual Studio user specific files
.vsconfig
GantryExamples.code-workspace
.vs/

# Idea user specific files
.idea/
*.DotSettings.user

# Linux specific files
.ignore
.vscode/
Makefile

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug symbols
*.pdb

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*
Plugins/*/*/Binaries/*
Plugins/*/*/*/Binaries/*
Plugins/*/*/*/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*
Plugins/*/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

#Plugins
Plugins/Marketplace/
DocGen/

# Plugins cloned in for development are their own repos: Gantry (UE-Gantry) ships from Fab into
# the engine, PVAS-DocGen (UE-PVAS-DocGen) never ships at all. The example's own game feature
# plugins (Plugins/GameFeatures/) are part of this project and tracked here.
/Plugins/Gantry/
/Plugins/PVAS-DocGen/

# Local development project: Dev/GantryExamplesDev.uproject is GantryExamples plus editor-only dev
# tooling (Python, MCP server and toolsets, the Blueprint scripting backport). It lives in its own
# folder, with Content, Config and Plugins symlinked to these, because the project is
# Blueprint-only: UnrealBuildTool generates each project file's targets and a stub module into
# Intermediate/Source, and two project files sharing one folder compile each other's stubs.
/Dev/
*-dev.uproject

# Local authoring tooling (e.g. Plugins/Dev/BlueprintScriptingBackport). Never part of the example.
/Plugins/Dev/

# Authoring and test tooling lives outside this repo (private); never commit it here.
/Tools/

# Release metadata from packaging with -createreleaseversion; mods cook against it locally.
/Releases/

# Mods are tracked as source (their .uplugin, Config and Content). What cooking them produces is not.
/Mods/*/Content/Paks/
/Mods/*/Saved/
/Mods/*/Intermediate/
/Mods/*/Binaries/
