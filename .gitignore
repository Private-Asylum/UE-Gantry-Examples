# Visual Studio user specific files
.vsconfig
GantryExamples.code-workspace
.vs/

# Idea user specific files
.idea/
*.DotSettings.user

# Linux specific files
.ignore
.vscode/
Makefile

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug symbols
*.pdb

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*
Plugins/*/*/Binaries/*
Plugins/*/*/*/Binaries/*
Plugins/*/*/*/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*
Plugins/*/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

#Plugins
Plugins/Marketplace/
DocGen/

# Every plugin here is its own repo, cloned in for development: Gantry (UE-Gantry)
# ships from Fab into the engine, PVAS-DocGen (UE-PVAS-DocGen) never ships at all.
Plugins/

# Local development project: GantryExamples.uproject plus editor-only dev tooling (Python,
# MCP server and toolsets). Never shipped; open this one locally.
*-dev.uproject
